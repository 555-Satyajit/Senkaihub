# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true

# Matches infra/docker-compose.yml (host ports 5442 / 6382)
DATABASE_URL=postgres://senkaihub:senkaihub@localhost:5442/senkaihub
# Valkey: db 0 is the Celery broker, db 1 is the Django cache
VALKEY_BROKER_URL=redis://:senkaihub@localhost:6382/0
VALKEY_CACHE_URL=redis://:senkaihub@localhost:6382/1

CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
